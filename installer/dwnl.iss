; This script is compiled locally. Never run setup/uninstall as part of packaging.
#ifndef PackageRoot
  #error PackageRoot must be generated by tools/package.ps1
#endif
#ifndef ExtensionId
  #error ExtensionId must be validated by tools/package.ps1
#endif
#ifdef ValidationOnly
  #define ProductName "Dwnl local validation - DO NOT DISTRIBUTE"
#else
  #define ProductName "Dwnl private prototype"
#endif

[Setup]
AppId={{B01F7A32-74CA-4C9E-BDD2-635B305A5480}
AppName={#ProductName}
AppVersion={#AppVersion}
DefaultDirName={localappdata}\Dwnl
UsePreviousAppDir=no
DisableDirPage=yes
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#PackageRoot}
OutputBaseFilename={#OutputName}
Compression=lzma2/fast
SolidCompression=yes
CloseApplications=no
RestartApplications=no
ChangesEnvironment=no
UninstallDisplayName={#ProductName}
Uninstallable=yes
SetupLogging=yes
WizardStyle=modern

[Files]
#include PackageRoot + "\payload-files.iss"

[Registry]
Root: HKCU; Subkey: "Software\Google\Chrome\NativeMessagingHosts\com.dwnl.host"; ValueType: string; ValueName: ""; ValueData: "{app}\native-host.json"

[Code]
const
  NativeKey = 'Software\Google\Chrome\NativeMessagingHosts\com.dwnl.host';
  GenericWrite = $40000000;
  OpenExisting = 3;
  FileAttributeNormal = $80;
  InvalidHandleValue = -1;
  FileAttributeReparsePoint = $400;
  InvalidFileAttributes = $FFFFFFFF;

function CreateFileW(FileName: string; Access, Share: Cardinal; Security: Integer;
  Creation, Flags: Cardinal; Template: Integer): THandle;
  external 'CreateFileW@kernel32.dll stdcall';
function CloseHandle(Handle: THandle): Boolean;
  external 'CloseHandle@kernel32.dll stdcall';
function GetFileAttributesW(FileName: string): Cardinal;
  external 'GetFileAttributesW@kernel32.dll stdcall';

function IsReparsePath(Path: string): Boolean;
var Attributes: Cardinal; Cursor: string;
begin
  Result := False;
  Cursor := Path;
  while Length(Cursor) > 3 do begin
    Attributes := GetFileAttributesW(Cursor);
    if (Attributes <> InvalidFileAttributes) and
       ((Attributes and FileAttributeReparsePoint) <> 0) then begin
      Result := True;
      Exit;
    end;
    Cursor := ExtractFileDir(Cursor);
  end;
end;

function JsonEscape(Value: string): string;
begin
  Result := Value;
  StringChangeEx(Result, '\', '\\', True);
  StringChangeEx(Result, '"', '\"', True);
end;

function ManifestContents(): string;
var Text: AnsiString;
begin
  if not LoadStringFromFile(ExpandConstant('{tmp}\native-host.json.template'), Text) then
    RaiseException('Owned native manifest template is unavailable.');
  Result := String(Text);
  StringChangeEx(Result, '@@HOST_PATH_JSON@@', JsonEscape(ExpandConstant('{app}\dwnl-host.exe')), True);
  StringChangeEx(Result, '@@EXTENSION_ID@@', '{#ExtensionId}', True);
end;

function OwnedFilesInactive(): Boolean;
var Files: TArrayOfString; I: Integer; Path: string; Handle: THandle;
begin
  Result := False;
  #include PackageRoot + "\owned-paths.iss"
  for I := 0 to GetArrayLength(Files) - 1 do begin
    Path := AddBackslash(ExpandConstant('{app}')) + Files[I];
    if IsReparsePath(Path) then Exit;
    if FileExists(Path) then begin
      Handle := CreateFileW(Path, GenericWrite, 0, 0, OpenExisting, FileAttributeNormal, 0);
      if Handle = InvalidHandleValue then Exit;
      CloseHandle(Handle);
    end;
  end;
  Result := True;
end;

function PrepareToInstall(var NeedsRestart: Boolean): string;
begin
  Result := '';
  if IsReparsePath(ExpandConstant('{app}')) then
    Result := 'Dwnl refuses an installation directory that contains a reparse point.'
  else if not OwnedFilesInactive() then
    Result := 'Close active Dwnl jobs before updating this installation. No process was terminated.';
end;

procedure CurStepChanged(CurStep: TSetupStep);
var Lines: TArrayOfString;
begin
  if CurStep = ssPostInstall then begin
    ExtractTemporaryFile('native-host.json.template');
    SetArrayLength(Lines, 1);
    Lines[0] := ManifestContents();
    if not SaveStringsToUTF8FileWithoutBOM(ExpandConstant('{app}\native-host.json'), Lines, False) then
      RaiseException('Native manifest write failed.');
  end;
end;

function InitializeUninstall(): Boolean;
begin
  Result := OwnedFilesInactive();
  if not Result then MsgBox('Close active Dwnl jobs before uninstalling. No process was terminated.', mbError, MB_OK);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var RegisteredPath, ManifestPath, Actual, Expected, HostPath: string; Lines: TArrayOfString; I: Integer;
begin
  if CurUninstallStep <> usUninstall then Exit;
  ManifestPath := ExpandConstant('{app}\native-host.json');
  if IsReparsePath(ManifestPath) then Exit;
  if not RegQueryStringValue(HKCU, NativeKey, '', RegisteredPath) then Exit;
  if CompareText(RegisteredPath, ManifestPath) <> 0 then Exit;
  if not LoadStringsFromFile(ManifestPath, Lines) then Exit;
  Actual := '';
  for I := 0 to GetArrayLength(Lines) - 1 do Actual := Actual + Lines[I] + #10;
  HostPath := JsonEscape(ExpandConstant('{app}\dwnl-host.exe'));
  // Manifest is generated with a fixed structure; exact normalized bytes prove ownership.
  Expected := '{' + #10 + '  "name": "com.dwnl.host",' + #10 +
    '  "description": "Dwnl private native helper",' + #10 +
    '  "path": "' + HostPath + '",' + #10 +
    '  "type": "stdio",' + #10 +
    '  "allowed_origins": ["chrome-extension://{#ExtensionId}/"]' + #10 + '}' + #10;
  StringChangeEx(Actual, #13#10, #10, True);
  if Trim(Actual) <> Trim(Expected) then Exit;
  if DeleteFile(ManifestPath) then begin
    RegDeleteValue(HKCU, NativeKey, '');
    RegDeleteKeyIfEmpty(HKCU, NativeKey);
  end;
end;

[Files]
Source: "native-host.json.template"; Flags: dontcopy
