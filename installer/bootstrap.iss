; Compile only. Manual setup execution and registration require later approval.
#ifndef PackageRoot
  #error PackageRoot must be generated by tools/bootstrap.ps1
#endif
[Setup]
AppId={{B01F7A32-74CA-4C9E-BDD2-635B305A5480}
#ifdef DesktopApp
AppName=Dwnl
#else
AppName=Dwnl private prototype
#endif
AppVersion={#AppVersion}
DefaultDirName={localappdata}\Dwnl
UsePreviousAppDir=no
DisableDirPage=yes
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#PackageRoot}
OutputBaseFilename=Dwnl-Setup
Compression=lzma2/fast
SolidCompression=yes
#include "bootstrap-archive-settings.iss"
CloseApplications=no
RestartApplications=no
ChangesEnvironment=no
Uninstallable=yes
SetupLogging=yes
WizardStyle=modern

[Files]
#include PackageRoot + "\payload-files.iss"

#ifdef DesktopApp
[Icons]
Name: "{autoprograms}\Dwnl"; Filename: "{app}\Dwnl.exe"; WorkingDir: "{app}"
#endif

[Code]
var
  DownloadPage: TDownloadWizardPage;
  WasOwnedInstallation, NativeKeyExisted: Boolean;
const
  NativeKey = 'Software\Google\Chrome\NativeMessagingHosts\com.dwnl.host';

#include "bootstrap-ownership.iss"

procedure InitializeWizard();
begin
  DownloadPage := CreateDownloadPage('Dependências Dwnl', 'Baixando versões verificadas dos fornecedores oficiais.', nil);
  DownloadPage.ShowBaseNameInsteadOfUrl := True;
end;

function ExpectedManifest(): string;
begin
  Result := ExpectedManifestFor(ExpandConstant('{app}'));
end;

function ManifestMatches(): Boolean;
begin
  Result := ManifestMatchesFor(ExpandConstant('{app}'));
end;

function OwnedManifest(): Boolean;
var Registered: string;
begin
  Result := RegQueryStringValue(HKCU, NativeKey, '', Registered) and
    RegistrationMatchesFor(ExpandConstant('{app}'), Registered);
end;

function OwnedFilesInactive(): Boolean;
var Files: TArrayOfString;
begin
  #include PackageRoot + "\owned-paths.iss"
  Result := FilesInactiveFor(ExpandConstant('{app}'), Files);
end;

procedure RequireHash(Path, Expected: string);
begin
  if IsReparsePath(Path) or not FileExists(Path) or (CompareText(GetSHA256OfFile(Path), Expected) <> 0) then
    RaiseException('A pinned Dwnl supplier/payload hash did not match. No registration was created.');
end;

#include PackageRoot + "\supplier-acquisition.iss"

#ifdef DesktopApp
function HasWebView2(): Boolean;
var Version: string;
begin
  // Microsoft Evergreen detection, checked before downloading any suppliers.
  Result := RegQueryStringValue(HKLM32, 'Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Version) and
    (Version <> '') and (Version <> '0.0.0.0');
  if not Result then
    Result := RegQueryStringValue(HKCU, 'Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Version) and
      (Version <> '') and (Version <> '0.0.0.0');
end;
#endif
function PrepareToInstall(var NeedsRestart: Boolean): string;
var Registered: string;
begin
#ifdef DesktopApp
  if not HasWebView2() then begin
    Result := 'Instale o Microsoft Edge WebView2 Runtime (Evergreen) em https://developer.microsoft.com/microsoft-edge/webview2/ e execute este instalador novamente. Nenhuma alteração foi feita.';
    Exit;
  end;
#endif
  RegQueryStringValue(HKCU, NativeKey, '', Registered);
  Result := InstallationProblem(ExpandConstant('{app}'), ExpandConstant('{localappdata}\Dwnl'),
    RegValueExists(HKCU, NativeKey, ''), Registered);
  if Result <> '' then Exit;
  if not OwnedFilesInactive() then begin
    Result := 'Close Dwnl jobs before updating. No process was terminated.'; Exit;
  end;
  WasOwnedInstallation := OwnedManifest();
  NativeKeyExisted := RegKeyExists(HKCU, NativeKey);
  try
    AcquireSuppliers();
    // All download/hash/extraction failures occur before the install step.
    Registered := '';
    RegQueryStringValue(HKCU, NativeKey, '', Registered);
    if not OwnedFilesInactive() then begin
      Result := 'Close Dwnl jobs before updating. No process was terminated.'; Exit;
    end;
    Result := PrepareOwnedDirectory(ExpandConstant('{app}'), ExpandConstant('{localappdata}\Dwnl'),
      RegValueExists(HKCU, NativeKey, ''), Registered);
  except
    Result := GetExceptionMessage();
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var ManifestPath, Registered: string;
begin
  if CurStep <> ssPostInstall then Exit;
  VerifyInstalledPayload();
  ManifestPath := ExpandConstant('{app}\native-host.json');
  if not SaveStringToFile(ManifestPath, UTF8Encode(ExpectedManifest()), False) then
    RaiseException('Native manifest write failed; registration was not created.');
  if not RegWriteStringValue(HKCU, NativeKey, '', ManifestPath) then begin
    // Compensate only a new manifest/registration still matching our write.
    // Preserve an existing working installation and third-party replacements.
    // Keep the path-bound ownership marker, allowing a safe retry of a failed copy/registration.
    if not WasOwnedInstallation and ManifestMatches() then begin
      if RegQueryStringValue(HKCU, NativeKey, '', Registered) and
         (CompareText(Registered, ManifestPath) = 0) then RegDeleteValue(HKCU, NativeKey, '');
      if not NativeKeyExisted then RegDeleteKeyIfEmpty(HKCU, NativeKey);
      CompensateNewManifestFor(ExpandConstant('{app}'), WasOwnedInstallation);
    end;
    RaiseException('Native-host registration failed.');
  end;
end;

function InitializeUninstall(): Boolean;
begin
  Result := OwnedFilesInactive();
  if not Result then MsgBox('Close Dwnl jobs before uninstalling. No process was terminated.', mbError, MB_OK);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var Registered: string;
begin
  if (CurUninstallStep <> usUninstall) or not OwnedManifest() then Exit;
#ifdef DesktopApp
  if RegQueryStringValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Run', 'Dwnl', Registered) and
     (Registered = '"' + ExpandConstant('{app}\Dwnl.exe') + '" --background') then
    RegDeleteValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Run', 'Dwnl');
#endif
  DeleteOwnedPayload();
  RegQueryStringValue(HKCU, NativeKey, '', Registered);
  if DeleteOwnedManifestFor(ExpandConstant('{app}'), Registered) then begin
    RegDeleteValue(HKCU, NativeKey, ''); RegDeleteKeyIfEmpty(HKCU, NativeKey);
  end;
  RemoveDir(ExpandConstant('{app}\bin'));
  RemoveDir(ExpandConstant('{app}\licenses'));
end;
