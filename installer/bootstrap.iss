; Compile only. Manual setup execution and registration require later approval.
#ifndef PackageRoot
  #error PackageRoot must be generated by tools/bootstrap.ps1
#endif
[Setup]
AppId={{B01F7A32-74CA-4C9E-BDD2-635B305A5480}
#ifdef DesktopApp
AppName=Dwnl
#else
AppName=Dwnl private prototype
#endif
AppVersion={#AppVersion}
DefaultDirName={localappdata}\Dwnl
UsePreviousAppDir=no
DisableDirPage=yes
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
OutputDir={#PackageRoot}
OutputBaseFilename=Dwnl-Setup
Compression=lzma2/fast
SolidCompression=yes
#include "bootstrap-archive-settings.iss"
CloseApplications=no
RestartApplications=no
ChangesEnvironment=no
Uninstallable=yes
SetupLogging=yes
; Follows the Windows light or dark setting, as the app does. The images come
; from docs/branding/dwnl-logo.png through tools/installer-art.py.
WizardStyle=modern dynamic windows11
SetupIconFile=assets\dwnl.ico
WizardSmallImageFile=assets\dwnl-small-*.png
WizardImageFile=assets\dwnl-side-light-*.png
WizardImageFileDynamicDark=assets\dwnl-side-dark-*.png
#ifdef DesktopApp
UninstallDisplayIcon={app}\Dwnl.exe
#endif

[Languages]
Name: "ptbr"; MessagesFile: "compiler:Languages\BrazilianPortuguese.isl"

[Files]
#include PackageRoot + "\payload-files.iss"

#ifdef DesktopApp
[Icons]
Name: "{autoprograms}\Dwnl"; Filename: "{app}\Dwnl.exe"; WorkingDir: "{app}"

[Run]
; Reopens Dwnl after an update, including one started from the app.
Filename: "{app}\Dwnl.exe"; WorkingDir: "{app}"; Description: "Abrir o Dwnl"; Flags: postinstall nowait skipifdoesntexist
#endif

[Code]
var
  DownloadPage: TDownloadWizardPage;
  WasOwnedInstallation, NativeKeyExisted: Boolean;
const
  NativeKey = 'Software\Google\Chrome\NativeMessagingHosts\com.dwnl.host';

#include "bootstrap-ownership.iss"
#include "bootstrap-processes.iss"

procedure InitializeWizard();
begin
  DownloadPage := CreateDownloadPage('Dependências Dwnl', 'Baixando versões verificadas dos fornecedores oficiais.', nil);
  DownloadPage.ShowBaseNameInsteadOfUrl := True;
end;

function ExpectedManifest(): string;
begin
  Result := ExpectedManifestFor(ExpandConstant('{app}'));
end;

function ManifestMatches(): Boolean;
begin
  Result := ManifestMatchesFor(ExpandConstant('{app}'));
end;

function OwnedManifest(): Boolean;
var Registered: string;
begin
  Result := RegQueryStringValue(HKCU, NativeKey, '', Registered) and
    RegistrationMatchesFor(ExpandConstant('{app}'), Registered);
end;

function OwnedFilesInactive(): Boolean;
var Files: TArrayOfString;
begin
  #include PackageRoot + "\owned-paths.iss"
  Result := FilesInactiveFor(ExpandConstant('{app}'), Files);
end;

function WaitForOwnedFilesInactive(Seconds: Integer): Boolean;
var Tries: Integer;
begin
  Result := OwnedFilesInactive();
  Tries := Seconds * 4;
  while not Result and (Tries > 0) do begin
    Sleep(250);
    Tries := Tries - 1;
    Result := OwnedFilesInactive();
  end;
end;

#ifdef DesktopApp
// "Dwnl.exe --quit" asks a running Dwnl to quit as Sair does, saving its
// queue, and waits for it: 0 closed or not running, 3 a download is in
// progress (--force closes anyway), 4 a Dwnl too old to be asked.
function AskDwnlToQuit(Force: Boolean): Integer;
var Exe, Params: string;
  Code: Integer;
begin
  Result := -1;
  Exe := ExpandConstant('{app}\Dwnl.exe');
  if IsReparsePath(Exe) or not FileExists(Exe) then Exit;
  Params := '--quit';
  if Force then Params := Params + ' --force';
  if Exec(Exe, Params, ExpandConstant('{app}'), SW_HIDE, ewWaitUntilTerminated, Code) then Result := Code;
end;
#endif

// Closes a running Dwnl before its files are replaced or removed. Dwnl is
// first asked to quit, saving its queue. What still runs from the installation
// (a Dwnl too old to be asked, the Chrome bridge of an open extension panel)
// is ended only when the person chooses Fechar o Dwnl.
function CloseRunningDwnl(Action: string): Boolean;
var Choice: Integer;
#ifdef DesktopApp
  Code: Integer;
#endif
begin
  Result := OwnedFilesInactive();
  if Result then Exit;
#ifdef DesktopApp
  // An update started from the app is already closing it.
  if WaitForOwnedFilesInactive(3) then begin Result := True; Exit; end;
  Code := AskDwnlToQuit(False);
  if Code = 3 then begin
    if SuppressibleTaskDialogMsgBox('Um download está em andamento',
      'Para ' + Action + ', o Dwnl precisa fechar. O download para agora e volta para a fila.',
      mbConfirmation, MB_YESNO, ['Fechar o Dwnl', 'Agora não'], 0, IDNO) <> IDYES then Exit;
    Code := AskDwnlToQuit(True);
  end;
  if (Code = 0) and WaitForOwnedFilesInactive(5) then begin Result := True; Exit; end;
#endif
  repeat
    Choice := SuppressibleTaskDialogMsgBox('O Dwnl ainda está aberto',
      'Para ' + Action + ', o Dwnl e a conexão dele com o Chrome precisam fechar.',
      mbInformation, MB_YESNOCANCEL, ['Fechar o Dwnl'#13#10'Fecha agora. Um download em andamento para e volta para a fila.',
       'Tentar de novo'#13#10'Depois de usar Sair no ícone do Dwnl na bandeja e fechar o painel do Dwnl no Chrome.',
       'Cancelar'], 0, IDCANCEL);
    if Choice = IDCANCEL then Exit;
    if Choice = IDYES then begin
#ifdef DesktopApp
      if (AskDwnlToQuit(True) = 0) and WaitForOwnedFilesInactive(5) then begin Result := True; Exit; end;
#endif
      EndProcessesIn(ExpandConstant('{app}'));
    end;
    if WaitForOwnedFilesInactive(10) then begin Result := True; Exit; end;
  until False;
end;

procedure RequireHash(Path, Expected: string);
begin
  if IsReparsePath(Path) or not FileExists(Path) or (CompareText(GetSHA256OfFile(Path), Expected) <> 0) then
    RaiseException('Um arquivo baixado não confere com o hash esperado. Nada foi registrado.');
end;

#include PackageRoot + "\supplier-acquisition.iss"

#ifdef DesktopApp
function HasWebView2(): Boolean;
var Version: string;
begin
  // Microsoft Evergreen detection, checked before downloading any suppliers.
  Result := RegQueryStringValue(HKLM32, 'Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Version) and
    (Version <> '') and (Version <> '0.0.0.0');
  if not Result then
    Result := RegQueryStringValue(HKCU, 'Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}', 'pv', Version) and
      (Version <> '') and (Version <> '0.0.0.0');
end;
#endif
function PrepareToInstall(var NeedsRestart: Boolean): string;
var Registered: string;
begin
#ifdef DesktopApp
  if not HasWebView2() then begin
    Result := 'Instale o Microsoft Edge WebView2 Runtime (Evergreen) em https://developer.microsoft.com/microsoft-edge/webview2/ e execute este instalador novamente. Nenhuma alteração foi feita.';
    Exit;
  end;
#endif
  RegQueryStringValue(HKCU, NativeKey, '', Registered);
  Result := InstallationProblem(ExpandConstant('{app}'), ExpandConstant('{localappdata}\Dwnl'),
    RegValueExists(HKCU, NativeKey, ''), Registered);
  if Result <> '' then Exit;
  if not CloseRunningDwnl('atualizar') then begin
    Result := 'O Dwnl continua aberto, então nada foi alterado. Feche-o pelo Sair e execute o instalador de novo.'; Exit;
  end;
  WasOwnedInstallation := OwnedManifest();
  NativeKeyExisted := RegKeyExists(HKCU, NativeKey);
  try
    AcquireSuppliers();
    // All download/hash/extraction failures occur before the install step.
    Registered := '';
    RegQueryStringValue(HKCU, NativeKey, '', Registered);
    if not CloseRunningDwnl('atualizar') then begin
      Result := 'O Dwnl continua aberto, então nada foi alterado. Feche-o pelo Sair e execute o instalador de novo.'; Exit;
    end;
    Result := PrepareOwnedDirectory(ExpandConstant('{app}'), ExpandConstant('{localappdata}\Dwnl'),
      RegValueExists(HKCU, NativeKey, ''), Registered);
  except
    Result := GetExceptionMessage();
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
var ManifestPath, Registered: string;
begin
  if CurStep <> ssPostInstall then Exit;
  VerifyInstalledPayload();
  ManifestPath := ExpandConstant('{app}\native-host.json');
  if not SaveStringToFile(ManifestPath, UTF8Encode(ExpectedManifest()), False) then
    RaiseException('Não foi possível gravar a configuração da conexão com o Chrome. Nada foi registrado.');
  if not RegWriteStringValue(HKCU, NativeKey, '', ManifestPath) then begin
    // Compensate only a new manifest/registration still matching our write.
    // Preserve an existing working installation and third-party replacements.
    // Keep the path-bound ownership marker, allowing a safe retry of a failed copy/registration.
    if not WasOwnedInstallation and ManifestMatches() then begin
      if RegQueryStringValue(HKCU, NativeKey, '', Registered) and
         (CompareText(Registered, ManifestPath) = 0) then RegDeleteValue(HKCU, NativeKey, '');
      if not NativeKeyExisted then RegDeleteKeyIfEmpty(HKCU, NativeKey);
      CompensateNewManifestFor(ExpandConstant('{app}'), WasOwnedInstallation);
    end;
    RaiseException('Não foi possível registrar a conexão com o Chrome.');
  end;
end;

function InitializeUninstall(): Boolean;
begin
  Result := CloseRunningDwnl('desinstalar');
  if not Result then MsgBox('O Dwnl continua aberto, então nada foi removido. Feche-o pelo Sair e desinstale de novo.', mbError, MB_OK);
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var Registered: string;
begin
  if (CurUninstallStep <> usUninstall) or not OwnedManifest() then Exit;
#ifdef DesktopApp
  if RegQueryStringValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Run', 'Dwnl', Registered) and
     (Registered = '"' + ExpandConstant('{app}\Dwnl.exe') + '" --background') then
    RegDeleteValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Run', 'Dwnl');
#endif
  DeleteOwnedPayload();
  RegQueryStringValue(HKCU, NativeKey, '', Registered);
  if DeleteOwnedManifestFor(ExpandConstant('{app}'), Registered) then begin
    RegDeleteValue(HKCU, NativeKey, ''); RegDeleteKeyIfEmpty(HKCU, NativeKey);
  end;
  RemoveOwnedDirectories();
end;
